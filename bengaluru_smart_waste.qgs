  <projectlayers>

    <!-- ─── 01. OPTIMIZED ROUTES ─── -->
    <maplayer type="vector" geometry="Line" wktType="LineString"
      refreshOnNotifyEnabled="0" autoRefreshTime="0"
      hasScaleBasedVisibilityFlag="0" maxScale="0" minScale="1e+08">
      <id>optimized_routes_layer</id>
      <datasource>C:/clg/9thsem/projects/Spatial/data/processed/optimized_routes.gpkg|layername=optimized_routes</datasource>
      <layername>01. VRP Optimized Collection Routes</layername>
      <srs>
        <spatialrefsys nativeFormat="Wkt">
          <wkt>GEOGCRS["WGS 84",DATUM["World Geodetic System 1984",ELLIPSOID["WGS 84",6378137,298.257223563]],PRIMEM["Greenwich",0],UNIT["degree",0.0174532925199433],ID["EPSG",4326]]</wkt>
          <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
          <srsid>3452</srsid><srid>4326</srid>
          <authid>EPSG:4326</authid>
          <description>WGS 84</description>
          <projectionacronym>longlat</projectionacronym>
          <ellipsoidacronym>EPSG:7030</ellipsoidacronym>
          <geographicflag>true</geographicflag>
        </spatialrefsys>
      </srs>
      <provider encoding="UTF-8">ogr</provider>
      <renderer-v2 type="categorizedSymbol" attr="truck_id" forceraster="0" symbollevels="0" enableorderby="0" referencescale="-1">
        <categories>
          <category value="TRUCK_01" symbol="0" label="Truck 01 (Route A)" render="true"/>
          <category value="TRUCK_02" symbol="1" label="Truck 02 (Route B)" render="true"/>
          <category value="TRUCK_03" symbol="2" label="Truck 03 (Route C)" render="true"/>
          <category value="TRUCK_04" symbol="3" label="Truck 04 (Route D)" render="true"/>
        </categories>
        <symbols>
          <symbol type="line" name="0" alpha="1" clip_to_extent="1">
            <layer class="SimpleLine" locked="0" pass="0" enabled="1">
              <Option type="Map">
                <Option type="QString" name="line_color" value="255,42,109,255"/>
                <Option type="QString" name="line_width" value="1.8"/>
                <Option type="QString" name="capstyle" value="round"/>
                <Option type="QString" name="joinstyle" value="round"/>
              </Option>
            </layer>
          </symbol>
          <symbol type="line" name="1" alpha="1" clip_to_extent="1">
            <layer class="SimpleLine" locked="0" pass="0" enabled="1">
              <Option type="Map">
                <Option type="QString" name="line_color" value="0,230,118,255"/>
                <Option type="QString" name="line_width" value="1.8"/>
                <Option type="QString" name="capstyle" value="round"/>
                <Option type="QString" name="joinstyle" value="round"/>
              </Option>
            </layer>
          </symbol>
          <symbol type="line" name="2" alpha="1" clip_to_extent="1">
            <layer class="SimpleLine" locked="0" pass="0" enabled="1">
              <Option type="Map">
                <Option type="QString" name="line_color" value="0,240,255,255"/>
                <Option type="QString" name="line_width" value="1.8"/>
                <Option type="QString" name="capstyle" value="round"/>
                <Option type="QString" name="joinstyle" value="round"/>
              </Option>
            </layer>
          </symbol>
          <symbol type="line" name="3" alpha="1" clip_to_extent="1">
            <layer class="SimpleLine" locked="0" pass="0" enabled="1">
              <Option type="Map">
                <Option type="QString" name="line_color" value="255,214,0,255"/>
                <Option type="QString" name="line_width" value="1.8"/>
                <Option type="QString" name="capstyle" value="round"/>
                <Option type="QString" name="joinstyle" value="round"/>
              </Option>
            </layer>
          </symbol>
        </symbols>
      </renderer-v2>
    </maplayer>

    <!-- ─── 02. BIN SITES ─── -->
    <maplayer type="vector" geometry="Point" wktType="Point"
      refreshOnNotifyEnabled="0" autoRefreshTime="0"
      hasScaleBasedVisibilityFlag="0" maxScale="0" minScale="1e+08">
      <id>bin_sites_layer</id>
      <datasource>C:/clg/9thsem/projects/Spatial/data/processed/bin_sites.gpkg|layername=bin_sites</datasource>
      <layername>02. Priority Smart Bin Sites (Top 15%)</layername>
      <srs>
        <spatialrefsys nativeFormat="Wkt">
          <wkt>GEOGCRS["WGS 84",DATUM["World Geodetic System 1984",ELLIPSOID["WGS 84",6378137,298.257223563]],PRIMEM["Greenwich",0],UNIT["degree",0.0174532925199433],ID["EPSG",4326]]</wkt>
          <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
          <srsid>3452</srsid><srid>4326</srid>
          <authid>EPSG:4326</authid>
          <description>WGS 84</description>
          <projectionacronym>longlat</projectionacronym>
          <ellipsoidacronym>EPSG:7030</ellipsoidacronym>
          <geographicflag>true</geographicflag>
        </spatialrefsys>
      </srs>
      <provider encoding="UTF-8">ogr</provider>
      <renderer-v2 type="categorizedSymbol" attr="bin_type" forceraster="0" symbollevels="0">
        <categories>
          <category value="Smart Sensor Bin" symbol="0" label="Smart Sensor Bin (IoT)" render="true"/>
          <category value="Standard Collection Point" symbol="1" label="Standard Collection Point" render="true"/>
        </categories>
        <symbols>
          <symbol type="marker" name="0" alpha="0.95" clip_to_extent="1">
            <layer class="SimpleMarker" locked="0" pass="0" enabled="1">
              <Option type="Map">
                <Option type="QString" name="color" value="255,0,128,240"/>
                <Option type="QString" name="outline_color" value="255,255,255,255"/>
                <Option type="QString" name="outline_width" value="0.6"/>
                <Option type="QString" name="size" value="2.6"/>
                <Option type="QString" name="name" value="diamond"/>
              </Option>
            </layer>
          </symbol>
          <symbol type="marker" name="1" alpha="0.85" clip_to_extent="1">
            <layer class="SimpleMarker" locked="0" pass="0" enabled="1">
              <Option type="Map">
                <Option type="QString" name="color" value="255,179,0,200"/>
                <Option type="QString" name="outline_color" value="0,0,0,120"/>
                <Option type="QString" name="outline_width" value="0.3"/>
                <Option type="QString" name="size" value="1.5"/>
                <Option type="QString" name="name" value="circle"/>
              </Option>
            </layer>
          </symbol>
        </symbols>
      </renderer-v2>
    </maplayer>

    <!-- ─── 03. GETIS-ORD Gi* HOTSPOTS ─── -->
    <maplayer type="vector" geometry="Polygon" wktType="Polygon"
      refreshOnNotifyEnabled="0" autoRefreshTime="0"
      hasScaleBasedVisibilityFlag="0" maxScale="0" minScale="1e+08">
      <id>hotspots_layer</id>
      <datasource>C:/clg/9thsem/projects/Spatial/data/processed/final_predictions_with_shap.gpkg|layername=final_predictions_with_shap</datasource>
      <layername>03. Getis-Ord Gi* Waste Hotspots</layername>
      <srs>
        <spatialrefsys nativeFormat="Wkt">
          <wkt>GEOGCRS["WGS 84",DATUM["World Geodetic System 1984",ELLIPSOID["WGS 84",6378137,298.257223563]],PRIMEM["Greenwich",0],UNIT["degree",0.0174532925199433],ID["EPSG",4326]]</wkt>
          <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
          <srsid>3452</srsid><srid>4326</srid>
          <authid>EPSG:4326</authid>
          <description>WGS 84</description>
          <projectionacronym>longlat</projectionacronym>
          <ellipsoidacronym>EPSG:7030</ellipsoidacronym>
          <geographicflag>true</geographicflag>
        </spatialrefsys>
      </srs>
      <provider encoding="UTF-8">ogr</provider>
      <renderer-v2 type="categorizedSymbol" attr="hotspot_class" forceraster="0" symbollevels="0" enableorderby="0" referencescale="-1">
        <categories>
          <category value="Hotspot 99%" symbol="0" label="Hotspot 99% Confidence (Critical)" render="true"/>
          <category value="Hotspot 95%" symbol="1" label="Hotspot 95% Confidence (High)" render="true"/>
          <category value="Hotspot 90%" symbol="2" label="Hotspot 90% Confidence (Moderate)" render="true"/>
          <category value="Not Significant" symbol="3" label="Not Significant (Neutral)" render="true"/>
          <category value="Coldspot 90%" symbol="4" label="Coldspot 90% Confidence" render="true"/>
          <category value="Coldspot 95%" symbol="5" label="Coldspot 95% Confidence" render="true"/>
          <category value="Coldspot 99%" symbol="6" label="Coldspot 99% Confidence" render="true"/>
        </categories>
        <symbols>
          <!-- Hotspot 99%: Glowing Crimson -->
          <symbol type="fill" name="0" alpha="0.90" clip_to_extent="1">
            <layer class="SimpleFill" locked="0" pass="0" enabled="1">
              <Option type="Map">
                <Option type="QString" name="color" value="230,57,70,230"/>
                <Option type="QString" name="outline_color" value="0,0,0,0"/>
                <Option type="QString" name="outline_width" value="0"/>
                <Option type="QString" name="outline_style" value="no"/>
              </Option>
            </layer>
          </symbol>
          <!-- Hotspot 95%: Vivid Orange -->
          <symbol type="fill" name="1" alpha="0.85" clip_to_extent="1">
            <layer class="SimpleFill" locked="0" pass="0" enabled="1">
              <Option type="Map">
                <Option type="QString" name="color" value="251,133,0,220"/>
                <Option type="QString" name="outline_color" value="0,0,0,0"/>
                <Option type="QString" name="outline_width" value="0"/>
                <Option type="QString" name="outline_style" value="no"/>
              </Option>
            </layer>
          </symbol>
          <!-- Hotspot 90%: Warm Gold -->
          <symbol type="fill" name="2" alpha="0.80" clip_to_extent="1">
            <layer class="SimpleFill" locked="0" pass="0" enabled="1">
              <Option type="Map">
                <Option type="QString" name="color" value="255,183,3,210"/>
                <Option type="QString" name="outline_color" value="0,0,0,0"/>
                <Option type="QString" name="outline_width" value="0"/>
                <Option type="QString" name="outline_style" value="no"/>
              </Option>
            </layer>
          </symbol>
          <!-- Not Significant: 100% Transparent (City & roads show through) -->
          <symbol type="fill" name="3" alpha="0" clip_to_extent="1">
            <layer class="SimpleFill" locked="0" pass="0" enabled="1">
              <Option type="Map">
                <Option type="QString" name="color" value="0,0,0,0"/>
                <Option type="QString" name="outline_color" value="0,0,0,0"/>
                <Option type="QString" name="outline_width" value="0"/>
                <Option type="QString" name="outline_style" value="no"/>
              </Option>
            </layer>
          </symbol>
          <!-- Coldspot 90%: Soft Cyan -->
          <symbol type="fill" name="4" alpha="0.75" clip_to_extent="1">
            <layer class="SimpleFill" locked="0" pass="0" enabled="1">
              <Option type="Map">
                <Option type="QString" name="color" value="72,202,228,190"/>
                <Option type="QString" name="outline_color" value="0,0,0,0"/>
                <Option type="QString" name="outline_width" value="0"/>
                <Option type="QString" name="outline_style" value="no"/>
              </Option>
            </layer>
          </symbol>
          <!-- Coldspot 95%: Azure Blue -->
          <symbol type="fill" name="5" alpha="0.80" clip_to_extent="1">
            <layer class="SimpleFill" locked="0" pass="0" enabled="1">
              <Option type="Map">
                <Option type="QString" name="color" value="0,119,182,210"/>
                <Option type="QString" name="outline_color" value="0,0,0,0"/>
                <Option type="QString" name="outline_width" value="0"/>
                <Option type="QString" name="outline_style" value="no"/>
              </Option>
            </layer>
          </symbol>
          <!-- Coldspot 99%: Deep Royal Navy -->
          <symbol type="fill" name="6" alpha="0.85" clip_to_extent="1">
            <layer class="SimpleFill" locked="0" pass="0" enabled="1">
              <Option type="Map">
                <Option type="QString" name="color" value="3,4,94,220"/>
                <Option type="QString" name="outline_color" value="0,0,0,0"/>
                <Option type="QString" name="outline_width" value="0"/>
                <Option type="QString" name="outline_style" value="no"/>
              </Option>
            </layer>
          </symbol>
        </symbols>
      </renderer-v2>
    </maplayer>

    <!-- ─── 04. GEO-SHAP DRIVERS ─── -->
    <maplayer type="vector" geometry="Polygon" wktType="Polygon"
      refreshOnNotifyEnabled="0" autoRefreshTime="0"
      hasScaleBasedVisibilityFlag="0" maxScale="0" minScale="1e+08">
      <id>shap_drivers_layer</id>
      <datasource>C:/clg/9thsem/projects/Spatial/data/processed/final_predictions_with_shap.gpkg|layername=final_predictions_with_shap</datasource>
      <layername>04. Geo-SHAP Dominant Feature Drivers</layername>
      <srs>
        <spatialrefsys nativeFormat="Wkt">
          <wkt>GEOGCRS["WGS 84",DATUM["World Geodetic System 1984",ELLIPSOID["WGS 84",6378137,298.257223563]],PRIMEM["Greenwich",0],UNIT["degree",0.0174532925199433],ID["EPSG",4326]]</wkt>
          <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
          <srsid>3452</srsid><srid>4326</srid>
          <authid>EPSG:4326</authid>
          <description>WGS 84</description>
          <projectionacronym>longlat</projectionacronym>
