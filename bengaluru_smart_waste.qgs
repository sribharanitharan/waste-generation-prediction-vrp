          <category value="transit_centrality"    symbol="6" label="Transit Hub Centrality" render="true"/>
          <category value="road_density"          symbol="7" label="Road Density"           render="true"/>
        </categories>
        <symbols>
          <symbol type="fill" name="0" alpha="0.80"><layer class="SimpleFill" locked="0" pass="0" enabled="1"><Option type="Map"><Option type="QString" name="color" value="231,76,60,200"/><Option type="QString" name="outline_color" value="0,0,0,0"/><Option type="QString" name="outline_style" value="no"/></Option></layer></symbol>
