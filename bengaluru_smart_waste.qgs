        <authid>EPSG:4326</authid>
        <description>WGS 84</description>
      </spatialrefsys>
    </destinationsrs>
    <rendermaptile>0</rendermaptile>
  </mapcanvas>

  <layer-tree-group>
    <custom-order enabled="0"/>
    <customproperties/>

    <!-- GROUP 1: Prescriptive Operations -->
    <layer-tree-group name="1. Prescriptive Operations (Routing &amp; Bins)" checked="Qt::Checked" expanded="1">
      <custom-order enabled="0"/>
      <layer-tree-layer id="optimized_routes_layer" name="01. VRP Optimized Collection Routes" source="C:/clg/9thsem/projects/Spatial/data/processed/optimized_routes.gpkg|layername=optimized_routes" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
      <layer-tree-layer id="bin_sites_layer" name="02. Priority Smart Bin Sites (Top 15%)" source="C:/clg/9thsem/projects/Spatial/data/processed/bin_sites.gpkg|layername=bin_sites" providerKey="ogr" checked="Qt::Unchecked" expanded="1"/>
    </layer-tree-group>

    <!-- GROUP 2: Geo-XAI & Hotspots -->
    <layer-tree-group name="2. Spatial Explainable AI (Geo-SHAP) &amp; Hotspots" checked="Qt::Checked" expanded="1">
      <custom-order enabled="0"/>
      <layer-tree-layer id="hotspots_layer" name="03. Getis-Ord Gi* Waste Hotspots" source="C:/clg/9thsem/projects/Spatial/data/processed/final_predictions_with_shap.gpkg|layername=final_predictions_with_shap" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
      <layer-tree-layer id="shap_drivers_layer" name="04. Geo-SHAP Dominant Feature Drivers" source="C:/clg/9thsem/projects/Spatial/data/processed/final_predictions_with_shap.gpkg|layername=final_predictions_with_shap" providerKey="ogr" checked="Qt::Unchecked" expanded="1"/>
    </layer-tree-group>

    <!-- GROUP 3: Predictions & Carbon -->
    <layer-tree-group name="3. ML Predictions &amp; Carbon Impact" checked="Qt::Unchecked" expanded="0">
      <custom-order enabled="0"/>
      <layer-tree-layer id="pred_waste_layer" name="05. Predicted Total Waste (kg/day)" source="C:/clg/9thsem/projects/Spatial/data/processed/final_predictions_with_shap.gpkg|layername=final_predictions_with_shap" providerKey="ogr" checked="Qt::Unchecked" expanded="0"/>
      <layer-tree-layer id="carbon_impact_layer" name="06. IPCC GHG — Methane &amp; CO2e (kg/yr)" source="C:/clg/9thsem/projects/Spatial/data/processed/carbon_impact.gpkg|layername=carbon_impact" providerKey="ogr" checked="Qt::Unchecked" expanded="0"/>
    </layer-tree-group>

    <!-- GROUP 4: Administrative Boundaries & Context -->
    <layer-tree-group name="4. Administrative Boundaries &amp; Base Maps" checked="Qt::Checked" expanded="1">
      <custom-order enabled="0"/>
      <layer-tree-layer id="wards_layer" name="07. Bengaluru BBMP Ward Boundaries (243 Wards)" source="C:/clg/9thsem/projects/Spatial/data/raw/bengaluru_wards.geojson" providerKey="ogr" checked="Qt::Checked" expanded="0"/>
      <layer-tree-layer id="karnataka_layer" name="08. Karnataka State District Boundaries" source="C:/clg/9thsem/projects/Spatial/data/raw/karnataka_districts.geojson" providerKey="ogr" checked="Qt::Unchecked" expanded="0"/>
      <layer-tree-layer id="hex_grid_layer" name="09. Hexagonal Analysis Grid (250m)" source="C:/clg/9thsem/projects/Spatial/data/processed/hex_grid_250m.gpkg|layername=hex_grid_250m" providerKey="ogr" checked="Qt::Unchecked" expanded="0"/>
      <layer-tree-layer id="esri_dark_layer" name="10. Esri Dark Canvas Basemap (Recommended)" source="type=xyz&amp;url=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}&amp;zmax=16&amp;zmin=0" providerKey="wms" checked="Qt::Checked" expanded="0"/>
      <layer-tree-layer id="esri_sat_layer" name="11. Esri World Imagery Satellite (Optional)" source="type=xyz&amp;url=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}&amp;zmax=19&amp;zmin=0" providerKey="wms" checked="Qt::Unchecked" expanded="0"/>
      <layer-tree-layer id="osm_tiles_layer" name="12. OpenStreetMap Standard Basemap" source="type=xyz&amp;url=https://tile.openstreetmap.org/{z}/{x}/{y}.png&amp;zmax=19&amp;zmin=0" providerKey="wms" checked="Qt::Unchecked" expanded="0"/>
      <layer-tree-layer id="lst_layer" name="13. Landsat-9 Land Surface Temperature (°C)" source="C:/clg/9thsem/projects/Spatial/data/raw/landsat_lst/lst_celsius.tif" providerKey="gdal" checked="Qt::Unchecked" expanded="0"/>
      <layer-tree-layer id="ndbi_layer" name="14. Sentinel-2 NDBI Built-Up Index" source="C:/clg/9thsem/projects/Spatial/data/raw/sentinel2_indices/ndbi.tif" providerKey="gdal" checked="Qt::Unchecked" expanded="0"/>
      <layer-tree-layer id="ndvi_layer" name="15. Sentinel-2 NDVI Vegetation Index" source="C:/clg/9thsem/projects/Spatial/data/raw/sentinel2_indices/ndvi.tif" providerKey="gdal" checked="Qt::Unchecked" expanded="0"/>
    </layer-tree-group>

  </layer-tree-group>

  <snapping-config maxScale="0" minScale="0" enabled="0" scaleDependencyMode="0" mode="2" intersectionSnapping="0">
    <individual-layer-settings/>
