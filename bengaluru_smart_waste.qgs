          <symbol type="fill" name="3" alpha="0.80"><layer class="SimpleFill" locked="0" pass="0" enabled="1"><Option type="Map"><Option type="QString" name="color" value="230,126,34,200"/><Option type="QString" name="outline_color" value="0,0,0,0"/><Option type="QString" name="outline_style" value="no"/></Option></layer></symbol>
          <symbol type="fill" name="4" alpha="0.80"><layer class="SimpleFill" locked="0" pass="0" enabled="1"><Option type="Map"><Option type="QString" name="color" value="41,128,185,200"/><Option type="QString" name="outline_color" value="0,0,0,0"/><Option type="QString" name="outline_style" value="no"/></Option></layer></symbol>
          <symbol type="fill" name="5" alpha="0.80"><layer class="SimpleFill" locked="0" pass="0" enabled="1"><Option type="Map"><Option type="QString" name="color" value="243,156,18,200"/><Option type="QString" name="outline_color" value="0,0,0,0"/><Option type="QString" name="outline_style" value="no"/></Option></layer></symbol>
          <symbol type="fill" name="6" alpha="0.80"><layer class="SimpleFill" locked="0" pass="0" enabled="1"><Option type="Map"><Option type="QString" name="color" value="22,160,133,200"/><Option type="QString" name="outline_color" value="0,0,0,0"/><Option type="QString" name="outline_style" value="no"/></Option></layer></symbol>
          <symbol type="fill" name="7" alpha="0.80"><layer class="SimpleFill" locked="0" pass="0" enabled="1"><Option type="Map"><Option type="QString" name="color" value="127,140,141,200"/><Option type="QString" name="outline_color" value="0,0,0,0"/><Option type="QString" name="outline_style" value="no"/></Option></layer></symbol>
